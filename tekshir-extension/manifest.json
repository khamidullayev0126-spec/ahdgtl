{
  "manifest_version": 3,
  "name": "Tekshir — firibgarlardan himoya",
  "short_name": "Tekshir",
  "version": "1.0.0",
  "description": "Soxta bank, Click va Payme saytlaridan ogohlantiradi, havola va xabarlarni tekshiradi. Hammasi kompyuteringizda — hech narsa yuborilmaydi.",
  "homepage_url": "https://tekshir.ah-digital.uz",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Tekshir",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["engine.js", "text.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
