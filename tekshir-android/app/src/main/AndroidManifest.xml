<?xml version="1.0" encoding="utf-8"?>
<!-- Tekshir manifesti. Android Studio yaratgan AndroidManifest.xml o'rniga.
     1-bosqich: INTERNET (faqat havolalarni Google/VirusTotal'da tekshirish uchun).
     3-bosqich: QUERY_ALL_PACKAGES — o'rnatilgan ilovalarni ko'rish (xavfsizlik ilovalariga Google ruxsat beradi).
     2-bosqich: POST_NOTIFICATIONS (ogohlantirish ko'rsatish) va «Bildirishnomalarga kirish» xizmati (MessageGuard). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tekshir"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tekshir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Ulashish → Tekshir»: boshqa ilovadagi matn yoki havolani qabul qiladi -->
            <intent-filter android:label="Tekshir bilan tekshirish">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 4-bosqich: APK faylni o'rnatishdan oldin tekshirish.
                 Telegram'da APK bosilganda «Tekshir bilan ochish» chiqadi; «Ulashish → Tekshir» ham ishlaydi. -->
            <intent-filter android:label="Tekshir: o'rnatishdan oldin tekshirish">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter android:label="Tekshir bilan tekshirish">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- 2-bosqich: xabarlarni kuzatish. Foydalanuvchi o'zi Sozlamalarda ruxsat beradi. -->
        <service
            android:name=".guard.MessageGuard"
            android:exported="true"
            android:label="Tekshir — xabarlarni tekshirish"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 6-bosqich: qo'ng'iroqda ogohlantirish (Android 10+, «spam aniqlovchi» roli). Qo'ng'iroqni bloklamaydi. -->
        <service
            android:name=".guard.CallGuard"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            tools:targetApi="29">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
