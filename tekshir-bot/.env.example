# Bu faylni nusxalab ".env" nomi bilan saqlang va qiymatlarni to'ldiring.
# .env fayli GitHub'ga YUKLANMAYDI (.gitignore'da). Kalitlarni hech kimga bermang.

# BotFather bergan token (1-bosqichda kerak)
BOT_TOKEN=

# Adminlarning Telegram ID'lari, vergul bilan (/stats uchun, 6-bosqich)
ADMIN_IDS=

# Keyingi bosqichlar uchun (hozircha bo'sh qoldiring)
VIRUSTOTAL_KEY=
SAFE_BROWSING_KEY=
# AI tahlili (9-bosqich): Anthropic API kaliti (console.anthropic.com). Bo'sh bo'lsa — AI o'chiq
AI_API_KEY=
# Model (standart: claude-opus-5-5). Arzonroq variant: claude-haiku-5-5
AI_MODEL=
# Kunlik limitlar: bitta foydalanuvchi / hammasi (pulni tejash uchun)
AI_USER_DAILY=20
AI_DAILY_LIMIT=300
# Telefon/karta raqamlarini hash qilish uchun maxfiy so'z (7-bosqich).
# Yaratish: terminalda  openssl rand -hex 32  — va KEYIN O'ZGARTIRMANG
HASH_SALT=

# 10-bosqich: so'rovlar chegarasi (daqiqasiga)
RATE_LIMIT=10
GROUP_RATE_LIMIT=30

# Serverda (Render) avtomatik: RENDER_EXTERNAL_URL. Boshqa serverda — botning ochiq manzili:
# WEBHOOK_URL=https://mening-serverim.uz
# Baza fayli joyi (Render'da: /var/data/tekshir.db)
# DB_PATH=

# Bepul serverda baza zaxirasi: yopiq Telegram kanal ID'si (bot u yerda admin). README: «Baza zaxirasi»
# BACKUP_CHAT_ID=-100...
